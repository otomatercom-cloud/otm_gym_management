<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gym_member_form" model="ir.ui.view">
      <field name="name">otm.gym.member.form</field>
      <field name="model">otm.gym.member</field>
      <field name="arch" type="xml">
        <form string="Member">
          <header>
        <button name="%(action_gym_reason_wizard)d" type="action" string="Deactivate" invisible="status not in ['prospect', 'active', 'frozen', 'expired']" context="{'default_method': 'action_deactivate', 'default_res_model': 'otm.gym.member', 'default_res_id': id}"/>
        <button name="action_reactivate" type="object" string="Reactivate" invisible="status not in ['inactive']"/>
        <button name="action_create_portal_user" type="object" string="Create app login" invisible="user_id"/>
        <field name="status" widget="statusbar" statusbar_visible="prospect,active,frozen,expired,inactive"/>
          </header>
          <sheet>
            <field name="image_128" widget="image" class="oe_avatar"/>
            <div class="oe_title"><h1><field name="name" placeholder="Member name"/></h1></div>
            <group name="main_cols">
            <group name="identity">
              <field name="member_code"/>
              <field name="name"/>
              <field name="status"/>
              <field name="join_date"/>
              <field name="fitness_goal"/>
              <field name="trainer_id"/>
              <field name="nutritionist_id"/>
            </group>
            <group name="contact">
              <field name="phone"/>
              <field name="whatsapp"/>
              <field name="email"/>
              <field name="date_of_birth"/>
              <field name="age"/>
              <field name="gender"/>
              <field name="user_id"/>
              <field name="partner_id"/>
              <field name="rfid_code"/>
            </group>
          </group>
            <notebook name="gym_notebook">
            <page name="membership_page" string="Membership">
              <group name="mem_group"><field name="current_membership_id"/><field name="membership_expiry"/><field name="plan_id"/><field name="outstanding_amount"/><field name="last_attendance_date"/><field name="last_assessment_date"/></group><field name="membership_ids" readonly="1"><list><field name="name"/><field name="plan_id"/><field name="start_date"/><field name="end_date"/><field name="final_amount"/><field name="payment_status"/><field name="state"/></list></field>
            </page>
            <page name="address_page" string="Address and Emergency">
              <group name="addr_group"><field name="address"/><field name="emergency_contact"/><field name="emergency_phone"/></group>
            </page>
            <page name="notes_page" string="Notes">
              <field name="notes" placeholder="Internal notes..."/>
            </page>
          </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
    <record id="view_gym_member_list" model="ir.ui.view">
      <field name="name">otm.gym.member.list</field>
      <field name="model">otm.gym.member</field>
      <field name="arch" type="xml">
        <list string="Members" decoration-success="status == 'active'" decoration-danger="status == 'expired'" decoration-muted="status == 'inactive'">
        <field name="member_code"/>
        <field name="name"/>
        <field name="phone"/>
        <field name="plan_id"/>
        <field name="membership_expiry"/>
        <field name="trainer_id"/>
        <field name="status"/>
        </list>
      </field>
    </record>
    <record id="view_gym_member_search" model="ir.ui.view">
      <field name="name">otm.gym.member.search</field>
      <field name="model">otm.gym.member</field>
      <field name="arch" type="xml">
        <search string="Members">
        <field name="name"/>
        <field name="member_code"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="trainer_id"/>
        <filter name="active_m" string="Active" domain="[('status','=','active')]"/>
        <filter name="expired_m" string="Expired" domain="[('status','=','expired')]"/>
        <filter name="frozen_m" string="Frozen" domain="[('status','=','frozen')]"/>
        <filter name="prospect_m" string="Prospects" domain="[('status','=','prospect')]"/>
        <separator/>
        <group>
          <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
          <filter name="group_trainer_id" string="Trainer" context="{'group_by': 'trainer_id'}"/>
          <filter name="group_plan_id" string="Plan" context="{'group_by': 'plan_id'}"/>
          <filter name="group_fitness_goal" string="Goal" context="{'group_by': 'fitness_goal'}"/>
        </group>
        </search>
      </field>
    </record>
    <record id="action_gym_member" model="ir.actions.act_window">
      <field name="name">Members</field>
      <field name="res_model">otm.gym.member</field>
      <field name="view_mode">list,form</field>
    </record>
</odoo>
