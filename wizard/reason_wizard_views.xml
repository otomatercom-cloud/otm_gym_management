<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gym_reason_wizard_form" model="ir.ui.view">
        <field name="name">otm.gym.reason.wizard.form</field>
        <field name="model">otm.gym.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason">
                <group name="main">
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="method" invisible="1"/>
                    <field name="reason" placeholder="A reason is required for this action"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_gym_reason_wizard" model="ir.actions.act_window">
        <field name="name">Reason</field>
        <field name="res_model">otm.gym.reason.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
