<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: one privilege per module, groups point to it with privilege_id (never category_id) -->
    <record id="res_groups_privilege_gym" model="res.groups.privilege">
        <field name="name">Gym Management</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_customizations"/>
    </record>

    <record id="group_gym_reception" model="res.groups">
        <field name="name">Reception</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Members, check-in, memberships, appointments, payment requests and renewals. No health data.</field>
    </record>
    <record id="group_gym_trainer" model="res.groups">
        <field name="name">Trainer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees only the members assigned to them: fitness data, workouts, assessments.</field>
    </record>
    <record id="group_gym_nutritionist" model="res.groups">
        <field name="name">Nutritionist</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Diet plans and nutrition/health data of their assigned members.</field>
    </record>
    <record id="group_gym_assessor" model="res.groups">
        <field name="name">Assessment Staff</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Performs fitness assessments. No medical/health profile.</field>
    </record>
    <record id="group_gym_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Confirms payments and refunds. Never sees health data.</field>
    </record>
    <record id="group_gym_manager" model="res.groups">
        <field name="name">Gym Manager</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_reception')), (4, ref('group_gym_trainer')),
                                          (4, ref('group_gym_nutritionist')), (4, ref('group_gym_assessor'))]"/>
        <field name="comment">Operational overview, approvals, overrides and corrections.</field>
    </record>
    <record id="group_gym_admin" model="res.groups">
        <field name="name">Gym Administrator</field>
        <field name="sequence">70</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configuration (plans, exercises, food master) and deletions.</field>
    </record>
    <record id="group_gym_customer" model="res.groups">
        <field name="name">Customer (Gym member)</field>
        <field name="sequence">80</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Portal login for a member: sees only their own data.</field>
    </record>
</odoo>
